# Production image: Dart Frog API plus the Flutter web release build.
# Build context is the repository root (see docker-compose.yml).
# Requires frontend/.env (passed to --dart-define-from-file). It is not
# committed; .dockerignore lets only that env file through.

FROM ghcr.io/cirruslabs/flutter:stable AS web

WORKDIR /workspace

COPY pubspec.yaml pubspec.lock ./
COPY core ./core
COPY frontend ./frontend

WORKDIR /workspace/frontend
RUN test -f .env || { echo "frontend/.env is required" >&2; exit 1; }
RUN flutter config --enable-web \
    && flutter pub get \
    && flutter build web --release --no-wasm-dry-run \
        -o .build/web --dart-define-from-file=.env

FROM dart:stable AS build

WORKDIR /workspace

COPY core ./core
COPY backend ./backend

RUN printf '%s\n' \
    'name: melist_workspace' \
    'publish_to: none' \
    'environment:' \
    '  sdk: ^3.12.0' \
    'workspace:' \
    '  - core' \
    '  - backend' \
    > pubspec.yaml

WORKDIR /workspace/backend
RUN dart pub get
RUN dart pub global activate dart_frog_cli
ENV PATH="/root/.pub-cache/bin:${PATH}"
RUN dart_frog build
RUN dart run dart_frog_swagger
RUN dart run tool/patch_openapi.dart

WORKDIR /workspace/backend/build
RUN dart pub get
RUN dart compile exe bin/server.dart -o /server

FROM scratch
COPY --from=build /runtime/ /
COPY --from=build /server /bin/server
COPY --from=build /workspace/backend/build/openapi.json \
    /app/build/openapi.json
COPY --from=build /workspace/backend/pubspec.yaml \
    /app/pubspec.yaml
COPY --from=web /workspace/frontend/.build/web /frontend/.build/web
WORKDIR /app
ENV PORT=8080
ENV WEB_ROOT=/frontend/.build/web
EXPOSE 8080
CMD ["/bin/server"]
